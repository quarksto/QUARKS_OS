generator client {
  provider             = "d:/QUARKS_OS/src/calc_engine/venv/Scripts/prisma-client-py.exe"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  INTEGRADOR
  ENGENHARIA
  COMERCIAL
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

// Global Users (RBAC)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(INTEGRADOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]
  proposals     Proposal[]
  auditLogs     AuditLog[]
  agentSessions AgentSession[]

  @@map("users")
}

// CRM - Leads
model Lead {
  id          String     @id @default(uuid())
  name        String
  email       String?
  phone       String?
  consumption Float // Monthly average consumption in kWh
  location    String? // City/State or Zip
  distributor String? // Energy distributor (Enel, Cemig, etc.)
  status      LeadStatus @default(NEW)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  proposals Proposal[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("leads")
}

// Solar Proposals
model Proposal {
  id             String         @id @default(uuid())
  title          String
  generationKwh  Float // Monthly generation
  systemSizeKwp  Float // System size
  totalPrice     Float
  paybackYears   Float
  savingsMonthly Float
  status         ProposalStatus @default(DRAFT)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  kitId String?
  kit   Kit?    @relation(fields: [kitId], references: [id])

  pdfUrl String? // Link to generated PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("proposals")
}

// Energy Tariffs (Lookup)
model Tariff {
  id          String    @id @default(uuid())
  distributor String
  state       String
  priceKwh    Float // Price per kWh
  validFrom   DateTime
  validTo     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([distributor, state])
  @@map("tariffs")
}

// Commercial Core - Products & Pricing

enum ProductType {
  MODULE // Painel
  INVERTER // Inversor
  STRUCTURE // Estrutura
  CABLE // Cabos
  OTHER // String box, conectores
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique
  name        String
  description String?
  type        ProductType
  costPrice   Float // Custo base (sem impostos)
  supplier    String?
  specs       Json? // JSON flexível para specs (ex: { power: 550, efficiency: 21.5 })
  active      Boolean     @default(true)

  kits KitItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Kit {
  id          String  @id @default(uuid())
  name        String
  description String?
  active      Boolean @default(true)

  items     KitItem[]
  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kits")
}

model KitItem {
  id        String  @id @default(uuid())
  kitId     String
  kit       Kit     @relation(fields: [kitId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@map("kit_items")
}

model PricingRule {
  id           String @id @default(uuid())
  name         String
  minPower     Float // Potência mínima do sistema (0 = qualquer)
  maxPower     Float // Potência máxima
  targetMargin Float // Margem alvo (decimal, ex: 0.20 para 20%)
  taxRate      Float // Imposto estimado de saída (simples c/ difal mockado)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pricing_rules")
}

// Audit Logs
model AuditLog {
  id       String  @id @default(uuid())
  action   String
  resource String
  details  String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// AI Copilot
model AgentSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  context   Json? // Stores active intent, draft IDs, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AgentMessage[]

  @@map("agent_sessions")
}

model AgentMessage {
  id        String       @id @default(uuid())
  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id])
  role      String // USER, ASSISTANT, SYSTEM
  content   String       @db.Text
  metadata  Json? // Token usage, tool calls, etc.
  createdAt DateTime     @default(now())

  @@map("agent_messages")
}
