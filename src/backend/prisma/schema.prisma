generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(INTEGRADOR)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  agentSessions AgentSession[]
  auditLogs     AuditLog[]
  leads         Lead[]
  messages      Message[]
  projects      Project[]      @relation("AssignedTechnician")
  proposals     Proposal[]

  @@map("users")
}

model Lead {
  id             String     @id @default(uuid())
  name           String
  email          String?
  phone          String?
  consumption    Float
  location       String?
  distributor    String?
  status         LeadStatus @default(NEW)
  origin         String?
  cep            String?
  fullAddress    String?
  roofType       String?
  connectionType String?
  ownerId        String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  owner          User       @relation(fields: [ownerId], references: [id])
  messages       Message[]
  projects       Project[]
  proposals      Proposal[]

  @@map("leads")
}

model Proposal {
  id               String         @id @default(uuid())
  title            String
  generationKwh    Float
  systemSizeKwp    Float
  totalPrice       Float
  paybackYears     Float
  savingsMonthly   Float
  status           ProposalStatus @default(DRAFT)
  leadId           String
  creatorId        String
  kitId            String?
  pdfUrl           String?
  publicSlug       String?        @unique
  discountPercent  Float?
  discountAbsolute Float?
  notes            String?
  version          Int            @default(1)
  sentAt           DateTime?
  viewedAt         DateTime?
  acceptedAt       DateTime?
  viewedInPublicAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          Project?
  creator          User           @relation(fields: [creatorId], references: [id])
  kit              Kit?           @relation(fields: [kitId], references: [id])
  lead             Lead           @relation(fields: [leadId], references: [id])

  @@map("proposals")
}

model Project {
  id             String            @id @default(uuid())
  name           String
  status         ProjectStatus     @default(PLANNED)
  technicalNotes String?
  latitude       Float?
  longitude      Float?
  leadId         String
  proposalId     String?           @unique
  technicianId   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  activities     ProjectActivity[]
  lead           Lead              @relation(fields: [leadId], references: [id])
  proposal       Proposal?         @relation(fields: [proposalId], references: [id])
  technician     User?             @relation("AssignedTechnician", fields: [technicianId], references: [id])

  @@map("projects")
}

model ProjectActivity {
  id        String   @id @default(uuid())
  projectId String
  action    String
  details   String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@map("project_activities")
}

model Tariff {
  id          String    @id @default(uuid())
  distributor String
  state       String
  priceKwh    Float
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([distributor, state])
  @@map("tariffs")
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique
  name        String
  description String?
  type        ProductType
  costPrice   Float
  supplier    String?
  specs       Json?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  kits        KitItem[]

  @@map("products")
}

model Kit {
  id          String     @id @default(uuid())
  name        String
  description String?
  size_kwp    Float?
  price       Float?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       KitItem[]
  proposals   Proposal[]

  @@map("kits")
}

model KitItem {
  id        String  @id @default(uuid())
  kitId     String
  productId String
  quantity  Int     @default(1)
  kit       Kit     @relation(fields: [kitId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("kit_items")
}

model PricingRule {
  id           String   @id @default(uuid())
  name         String
  minPower     Float
  maxPower     Float
  targetMargin Float
  taxRate      Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pricing_rules")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  resource  String
  details   String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Message {
  id        String   @id @default(uuid())
  content   String
  role      String   @default("USER")
  leadId    String
  senderId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
  sender    User?    @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model AgentSession {
  id        String         @id @default(uuid())
  userId    String
  context   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]
  user      User           @relation(fields: [userId], references: [id])

  @@map("agent_sessions")
}

model AgentMessage {
  id        String       @id @default(uuid())
  sessionId String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime     @default(now())
  session   AgentSession @relation(fields: [sessionId], references: [id])

  @@map("agent_messages")
}

enum Role {
  INTEGRADOR
  ENGENHARIA
  COMERCIAL
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProjectStatus {
  PLANNED
  SURVEYING
  TECHNICAL_STUDY
  APPROVED
  INSTALLING
  COMPLETED
}


model Service {
  id          String         @id @default(uuid())
  name        String
  code        String?        @unique
  type        String
  description String?
  baseCost    Float?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  prices      ServicePrice[]

  @@map("services")
}

model ServicePrice {
  id         String   @id @default(uuid())
  serviceId  String
  state      String?
  minPower   Float    @default(0)
  maxPower   Float    @default(99999)
  priceType  String
  priceValue Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  service    Service  @relation(fields: [serviceId], references: [id])

  @@map("service_prices")
}

enum ProductType {
  MODULE
  INVERTER
  STRUCTURE
  CABLE
  OTHER
}
