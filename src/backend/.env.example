# Server
PORT=3001

# Database (Prisma)
# DATABASE_URL="postgresql://user:password@localhost:5432/quarks?schema=public"
# ou SQLite: file:./dev.db

# Auth
JWT_SECRET=change-me-in-production

# Frontend URL (para links no e-mail da proposta)
FRONTEND_URL=http://localhost:5173

# E-mail ao enviar proposta (opcional; se não definir, o corpo do e-mail é apenas logado)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Motor de proposta (HTML) e cálculos
# PYTHON_ENGINE_URL=http://127.0.0.1:8000

# Dashboard – metas (opcional)
# DASHBOARD_LEAD_GOAL=150
# DASHBOARD_CONVERSION_GOAL=15
# DASHBOARD_REVENUE_GOAL=2000000

# Google (Copilot / GenAI e Maps)
# GOOGLE_API_KEY=
# GOOGLE_MAPS_API_KEY=
